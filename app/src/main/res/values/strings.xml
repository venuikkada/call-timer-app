    <!-- Battery -->
    <string name="battery_title">Battery settings</string>
    <string name="battery_body">Your phone may stop CallGalli in the background, so calls might not be cut on time. Allow CallGalli to run without battery limits.</string>
    <string name="battery_saver_off">Battery saver is off</string>
    <string name="battery_unrestricted">No battery limits for CallGalli</string>
    <string name="battery_hint_xiaomi">On Xiaomi, Redmi and Poco phones: turn on Autostart for CallGalli and set Battery saver to \"No restrictions\".</string>
    <string name="battery_hint_samsung">On Samsung phones: open Battery, then set CallGalli to \"Unrestricted\" and remove it from Sleeping apps.</string>
    <string name="battery_hint_oppo">On Oppo, Realme and OnePlus phones: allow Auto launch and turn off battery optimisation for CallGalli.</string>
    <string name="battery_hint_vivo">On Vivo and iQOO phones: allow Background running and Auto-start for CallGalli.</string>

    <!-- Onboarding -->
    <string name="onb1_title">Keep calls short</string>
    <string name="onb1_body">CallGalli puts a time limit on calls, for each phone number:</string>
    <string name="onb1_point1">First call of the day: ends after 10 minutes.</string>
    <string name="onb1_point2">Second call: ends after 5 minutes.</string>
    <string name="onb1_point3">More calls that day are rejected until midnight. Emergency numbers and people you choose are never limited.</string>
    <string name="onb2_title">Make CallGalli your phone app</string>
    <string name="onb2_body">To end a call when time is up, CallGalli must be your default phone app. It shows incoming calls and the call screen.</string>
    <string name="onb2_screening_body">Call screening lets CallGalli reject a number that has used up today\'s calls, before your phone rings.</string>
    <string name="onb3_title">Names and calls</string>
    <string name="onb3_contacts_body">Contacts: so you see \"Ravi\" instead of a number, and can pick always-allowed people.</string>
    <string name="onb3_phone_body">Phone: so CallGalli can see calls and place calls from its dial pad.</string>
    <string name="onb4_title">Alerts</string>
    <string name="onb4_body">Notifications: to show incoming calls, the time left, and when a call is ended by the limit.</string>
    <string name="onb4_battery_body">Some phones stop apps to save battery. Allow CallGalli to run without battery limits so the timer is always on time.</string>
