<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- No INTERNET permission: call data can never leave the phone. -->

    <uses-feature android:name="android.hardware.telephony" android:required="true" />

    <!-- CallGalli works next to the phone's own dialer; it is not the phone app. -->
    <!-- See when a call rings / starts / ends. -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <!-- Know WHO is calling (the number comes with the phone-state broadcast only with this). -->
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <!-- Know which number you dialled in your phone app. -->
    <uses-permission android:name="android.permission.PROCESS_OUTGOING_CALLS" />
    <!-- End a call when time is up, and reject Stage 3 callers. -->
    <uses-permission android:name="android.permission.ANSWER_PHONE_CALLS" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Floating "07:42 left" pill on top of the phone app's call screen. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:name=".CallGalliApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.CallGalli">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Optional call screening: rejects Stage 3 non-contacts before the phone rings. -->
        <service
            android:name=".telecom.CallGalliScreeningService"
            android:exported="true"
            android:permission="android.permission.BIND_SCREENING_SERVICE">
            <intent-filter>
                <action android:name="android.telecom.CallScreeningService" />
            </intent-filter>
        </service>

        <!-- Always-on watcher: hears every call, runs the timer, shows the floating pill. -->
        <service
            android:name=".telecom.CallMonitorService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Watches phone calls made with the device dialer and ends them when the user's own daily time limit is reached." />
        </service>

        <receiver
            android:name=".telecom.CallActionReceiver"
            android:exported="false" />

        <receiver
            android:name=".telecom.PhoneEventReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.PHONE_STATE" />
                <action android:name="android.intent.action.NEW_OUTGOING_CALL" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".telecom.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
